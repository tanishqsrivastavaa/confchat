#!/usr/bin/env python3
import argparse
import curses
import fcntl
import getpass
import hashlib
import json
import os
import re
import signal
import sys
import textwrap
import time
from pathlib import Path


APP_DIR = Path("/var/tmp/confchat-data")
POLL_SECONDS = 0.15
USER_COLOR_START = 10
USER_COLOR_BASE = 100
USER_FG_COLOR = 90
CUSTOM_PAIR_START = 40
CUSTOM_COLOR_BASE = 120
MAX_CUSTOM_COLORS = 48
HEX_COLOR_RE = re.compile(r"^#?([0-9a-fA-F]{6})$")
USER_RGB_COLORS = (
    (120, 300, 230),
    (330, 280, 130),
    (150, 230, 390),
    (310, 210, 360),
    (110, 300, 330),
    (390, 190, 170),
    (270, 290, 320),
)
USER_256_COLORS = (
    23,
    58,
    60,
    95,
    24,
    88,
    238,
)
USER_BASIC_COLORS = (
    (curses.COLOR_WHITE, curses.COLOR_BLUE),
    (curses.COLOR_WHITE, curses.COLOR_MAGENTA),
    (curses.COLOR_BLACK, curses.COLOR_CYAN),
    (curses.COLOR_BLACK, curses.COLOR_GREEN),
    (curses.COLOR_WHITE, curses.COLOR_RED),
    (curses.COLOR_BLACK, curses.COLOR_YELLOW),
    (curses.COLOR_BLACK, curses.COLOR_WHITE),
)


def room_name(value):
    safe = "".join(ch if ch.isalnum() or ch in ("-", "_", ".") else "_" for ch in value.strip())
    return safe[:80] or "lobby"


def ensure_shared(path, directory=False):
    if directory:
        path.mkdir(parents=True, exist_ok=True)
        os.chmod(path, 0o1777)
    elif path.exists():
        os.chmod(path, 0o666)


class ChatStore:
    def __init__(self, base_dir, room):
        self.base_dir = Path(base_dir)
        ensure_shared(self.base_dir, directory=True)
        self.room = room_name(room)
        digest = hashlib.sha1(self.room.encode("utf-8")).hexdigest()[:10]
        self.log_path = self.base_dir / f"{self.room}-{digest}.jsonl"
        self.lock_path = self.base_dir / f"{self.room}-{digest}.lock"
        self.log_path.touch(exist_ok=True)
        self.lock_path.touch(exist_ok=True)
        ensure_shared(self.log_path)
        ensure_shared(self.lock_path)

    def append(self, user, text):
        record = {
            "type": "message",
            "id": f"{time.time_ns()}-{os.getpid()}",
            "ts": time.time(),
            "user": user,
            "text": text,
        }
        self.append_record(record)

    def append_color(self, user, color):
        record = {
            "type": "color",
            "id": f"{time.time_ns()}-{os.getpid()}",
            "ts": time.time(),
            "user": user,
            "color": color,
        }
        self.append_record(record)

    def append_record(self, record):
        line = json.dumps(record, ensure_ascii=True, separators=(",", ":")) + "\n"
        with self.lock_path.open("r+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            with self.log_path.open("a", encoding="utf-8") as log:
                log.write(line)
                log.flush()
                os.fsync(log.fileno())
            fcntl.flock(lock, fcntl.LOCK_UN)

    def load(self):
        messages = []
        try:
            with self.log_path.open("r", encoding="utf-8") as log:
                for line in log:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        item = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if {"ts", "user"} <= set(item) and ("text" in item or "color" in item):
                        item.setdefault("type", "message" if "text" in item else "color")
                        messages.append(item)
        except FileNotFoundError:
            pass
        return messages


def visible_len(value):
    return len(value.replace("\t", "    "))


def add_line(win, y, x, text, width, attr=0):
    if y < 0 or y >= win.getmaxyx()[0] or width <= 0:
        return
    try:
        win.addnstr(y, x, text, width, attr)
    except curses.error:
        pass


def format_time(ts):
    return time.strftime("%H:%M", time.localtime(float(ts)))


def normalize_hex_color(value):
    match = HEX_COLOR_RE.match(value.strip())
    if not match:
        return None
    return f"#{match.group(1).lower()}"


def hex_to_rgb1000(color):
    raw = color.lstrip("#")
    return tuple(round(int(raw[idx : idx + 2], 16) * 1000 / 255) for idx in (0, 2, 4))


def hex_to_256(color):
    raw = color.lstrip("#")
    r, g, b = (int(raw[idx : idx + 2], 16) for idx in (0, 2, 4))
    if max(r, g, b) - min(r, g, b) < 10:
        gray = round((r / 255) * 23)
        return 232 + max(0, min(23, gray))
    levels = [0, 95, 135, 175, 215, 255]
    ri, gi, bi = (min(range(6), key=lambda idx: abs(channel - levels[idx])) for channel in (r, g, b))
    return 16 + (36 * ri) + (6 * gi) + bi


def color_state(messages):
    users = []
    seen = set()
    for msg in messages:
        user = str(msg.get("user", ""))
        if not user:
            continue
        if user not in seen:
            seen.add(user)
            users.append(user)
    defaults = {user: USER_COLOR_START + (idx % len(USER_RGB_COLORS)) for idx, user in enumerate(users)}
    overrides = {}
    for msg in messages:
        if msg.get("type") != "color":
            continue
        color = normalize_hex_color(str(msg.get("color", "")))
        if color:
            overrides[str(msg.get("user", ""))] = color
    return defaults, overrides


class UserColorRegistry:
    def __init__(self):
        self.custom_pairs = {}

    def pair_for(self, fallback_pair, color):
        if not color:
            return fallback_pair
        if color in self.custom_pairs:
            return self.custom_pairs[color]
        if len(self.custom_pairs) >= MAX_CUSTOM_COLORS:
            return fallback_pair

        offset = len(self.custom_pairs)
        pair_id = CUSTOM_PAIR_START + offset
        if curses.has_colors() and curses.can_change_color() and curses.COLORS > CUSTOM_COLOR_BASE + offset:
            color_id = CUSTOM_COLOR_BASE + offset
            curses.init_color(color_id, *hex_to_rgb1000(color))
            curses.init_pair(pair_id, USER_FG_COLOR, color_id)
        elif curses.COLORS >= 256:
            curses.init_pair(pair_id, 250, hex_to_256(color))
        else:
            return fallback_pair
        self.custom_pairs[color] = pair_id
        return pair_id


def init_user_colors():
    if curses.has_colors() and curses.can_change_color() and curses.COLORS > USER_COLOR_BASE + len(USER_RGB_COLORS):
        curses.init_color(USER_FG_COLOR, 900, 880, 820)
        for offset, rgb in enumerate(USER_RGB_COLORS):
            color_id = USER_COLOR_BASE + offset
            curses.init_color(color_id, *rgb)
            curses.init_pair(USER_COLOR_START + offset, USER_FG_COLOR, color_id)
        return

    if curses.COLORS >= 256:
        for offset, bg in enumerate(USER_256_COLORS):
            curses.init_pair(USER_COLOR_START + offset, 250, bg)
        return

    for offset, (fg, bg) in enumerate(USER_BASIC_COLORS):
        curses.init_pair(USER_COLOR_START + offset, fg, bg)


def render_messages(messages, width, color_registry):
    lines = []
    body_width = max(10, width - 2)
    defaults, overrides = color_state(messages)
    for msg in messages:
        if msg.get("type") != "message":
            continue
        user = str(msg["user"])
        color = color_registry.pair_for(defaults.get(user, USER_COLOR_START), overrides.get(user))
        prefix = f"{format_time(msg['ts'])} {user}: "
        text = str(msg["text"]).replace("\n", " ")
        if text.startswith("/me "):
            prefix = f"{format_time(msg['ts'])} * "
            text = f"{user} {text[4:]}"
        first_width = max(8, body_width - visible_len(prefix))
        wrapped = textwrap.wrap(text, width=first_width, replace_whitespace=False) or [""]
        lines.append((prefix + wrapped[0], color, True))
        cont_prefix = " " * min(visible_len(prefix), body_width - 1)
        cont_width = max(8, body_width - visible_len(cont_prefix))
        for part in wrapped[1:]:
            for continued in textwrap.wrap(part, width=cont_width, replace_whitespace=False) or [""]:
                lines.append((cont_prefix + continued, color, False))
    return lines


def draw(stdscr, store, nick):
    curses.curs_set(1)
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(2, curses.COLOR_CYAN, -1)
    curses.init_pair(3, curses.COLOR_YELLOW, -1)
    init_user_colors()
    color_registry = UserColorRegistry()
    stdscr.timeout(int(POLL_SECONDS * 1000))

    typed = ""
    status = ""
    scroll = 0
    follow = True
    messages = []
    last_count = 0

    while True:
        height, width = stdscr.getmaxyx()
        min_ok = height >= 8 and width >= 36
        if min_ok:
            messages = store.load()
            if follow:
                scroll = 0
            elif len(messages) != last_count:
                status = "New messages below"
            last_count = len(messages)

        stdscr.erase()
        if not min_ok:
            add_line(stdscr, 0, 0, "Make the terminal at least 36x8.", width)
            stdscr.refresh()
            stdscr.getch()
            continue

        title = f" confchat | room: {store.room} | nick: {nick} "
        add_line(stdscr, 0, 0, title.ljust(width), width, curses.color_pair(1) | curses.A_BOLD)

        footer = " Enter sends | /color #hex | /me action | /quit exits | PgUp/PgDn scroll "
        add_line(stdscr, height - 2, 0, footer.ljust(width), width, curses.color_pair(2))

        prompt = "> "
        input_width = max(1, width - len(prompt) - 1)
        cursor_text = typed[-input_width:]
        add_line(stdscr, height - 1, 0, prompt, width, curses.A_BOLD)
        add_line(stdscr, height - 1, len(prompt), cursor_text, input_width)
        try:
            stdscr.move(height - 1, len(prompt) + len(cursor_text))
        except curses.error:
            pass

        body_height = height - 3
        rendered = render_messages(messages, width, color_registry)
        total = len(rendered)
        if follow:
            start = max(0, total - body_height)
        else:
            start = max(0, total - body_height - scroll)
        visible = rendered[start : start + body_height]
        blank_lines = body_height - len(visible)
        for row in range(blank_lines):
            add_line(stdscr, 1 + row, 0, "", width)
        for row, (line, color, is_first) in enumerate(visible, start=1 + blank_lines):
            attr = curses.color_pair(color)
            if is_first:
                attr |= curses.A_BOLD
            add_line(stdscr, row, 0, f" {line}".ljust(width - 1), width - 1, attr)

        if status:
            add_line(stdscr, height - 2, max(0, width - len(status) - 2), f" {status} ", width, curses.color_pair(3))

        stdscr.refresh()
        key = stdscr.getch()
        status = ""

        if key == -1:
            continue
        if key in (3, 4):
            return
        if key in (curses.KEY_RESIZE, 12):
            continue
        if key in (curses.KEY_PPAGE,):
            follow = False
            scroll = min(scroll + max(1, body_height // 2), max(0, total - body_height))
            continue
        if key in (curses.KEY_NPAGE,):
            scroll = max(0, scroll - max(1, body_height // 2))
            follow = scroll == 0
            continue
        if key in (curses.KEY_HOME,):
            follow = False
            scroll = max(0, total - body_height)
            continue
        if key in (curses.KEY_END,):
            follow = True
            scroll = 0
            continue
        if key in (curses.KEY_BACKSPACE, 127, 8):
            typed = typed[:-1]
            continue
        if key in (10, 13):
            text = typed.strip()
            typed = ""
            if not text:
                continue
            if text == "/quit":
                return
            if text == "/clear":
                messages = []
                continue
            if text.startswith("/color "):
                color = normalize_hex_color(text.split(maxsplit=1)[1])
                if not color:
                    status = "Use /color #6f8f7a"
                    continue
                try:
                    store.append_color(nick, color)
                    status = f"Color set to {color}"
                except OSError as exc:
                    status = f"Color failed: {exc}"
                continue
            try:
                store.append(nick, text[:2000])
                follow = True
                scroll = 0
            except OSError as exc:
                status = f"Send failed: {exc}"
            continue
        if 32 <= key <= 126:
            typed += chr(key)


def main():
    parser = argparse.ArgumentParser(description="Realtime TUI chat for users on the same machine.")
    parser.add_argument("-r", "--room", default="lobby", help="room name, default: lobby")
    parser.add_argument("-n", "--nick", default=getpass.getuser(), help="display name")
    parser.add_argument("--data-dir", default=str(APP_DIR), help="shared data directory")
    args = parser.parse_args()

    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    store = ChatStore(args.data_dir, args.room)
    curses.wrapper(draw, store, args.nick[:32] or getpass.getuser())


if __name__ == "__main__":
    main()
