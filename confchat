#!/usr/bin/env python3
"""Run confchat from a source checkout without installing it.

When installed with pip/pipx, use the console script instead; this shim only
exists so existing symlinks (e.g. /usr/local/bin/confchat) keep working when
they point at a checkout of this repository.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))

from confchat.cli import main

if __name__ == "__main__":
    main()
